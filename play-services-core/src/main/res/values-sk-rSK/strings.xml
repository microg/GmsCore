    <string name="pref_auth_strip_device_name_title">Odstrániť názov zariadenia pre overenie</string>
    <string name="pref_auth_strip_device_name_summary">Keď je toto povolené, požiadavky na overenie nebudú obsahovať názov zariadenia, čo môže umožniť neautorizovaným zariadeniam prihlásiť sa, ale môže to mať nepredvídané dôsledky.</string>
