    <string name="pref_auth_trust_google_title">Dôverovať Google pre povolenia aplikácií</string>
    <string name="pref_auth_trust_google_summary">Keď je vypnuté, používateľ je požiadaný pred odoslaním žiadosti o povolenie aplikácie do služby Google. Niektoré aplikácie nebudú môcť používať účet Google, ak je to vypnuté.</string>
