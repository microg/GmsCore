-+        if (tm != null) {
-+            tm.listen(sPhoneStateListener, PhoneStateListener.LISTEN_NONE);
-+        }
-+        sPhoneStateListener = null;
-+        Log.d(TAG, "call state listener unregistered");
-+    }
