<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/d2d_disabled" />
            <corners android:radius="@dimen/d2d_button_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/d2d_primary_pressed" />
            <corners android:radius="@dimen/d2d_button_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/d2d_primary" />
            <corners android:radius="@dimen/d2d_button_radius" />
        </shape>
    </item>
</selector>
