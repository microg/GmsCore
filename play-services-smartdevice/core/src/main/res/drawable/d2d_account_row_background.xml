<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/d2d_primary_container" />
            <stroke android:width="2dp" android:color="@color/d2d_primary" />
            <corners android:radius="@dimen/d2d_card_radius" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/d2d_surface_container" />
            <stroke android:width="2dp" android:color="@color/d2d_primary" />
            <corners android:radius="@dimen/d2d_card_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/d2d_primary_container" />
            <stroke android:width="1dp" android:color="@color/d2d_outline" />
            <corners android:radius="@dimen/d2d_card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/d2d_surface_container" />
            <stroke android:width="1dp" android:color="@color/d2d_outline" />
            <corners android:radius="@dimen/d2d_card_radius" />
        </shape>
    </item>
</selector>
