<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/d2d_account_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/d2d_account_row_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/d2d_account_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textColor="@color/d2d_text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/d2d_google_account"
            android:textColor="@color/d2d_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
