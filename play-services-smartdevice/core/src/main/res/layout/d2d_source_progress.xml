<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/d2d_surface"
    android:padding="@dimen/d2d_page_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/d2d_icon_background"
            android:padding="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_d2d_devices" />
        </FrameLayout>

        <ProgressBar
            android:id="@+id/d2d_progress_indicator"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:contentDescription="@string/d2d_transfer_in_progress"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/d2d_progress_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/d2d_text_primary"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/d2d_progress_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:maxWidth="440dp"
            android:textColor="@color/d2d_text_secondary"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
